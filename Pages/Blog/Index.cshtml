@page
@model TaskManager.Pages.Blog.IndexModel
@{
    ViewData["Title"] = "News Blog";
}

<div class="row">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="display-4">News Blog</h1>
            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <a asp-page="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i> New Post
                </a>
            }
        </div>

        @if (!Model.BlogPosts.Any())
        {
            <div class="alert alert-info">
                <h4>No blog posts yet</h4>
                <p>Be the first to share your news!</p>
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <a asp-page="Create" class="btn btn-primary">Create First Post</a>
                }
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var post in Model.BlogPosts)
                {
                    <div class="col-md-6 mb-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <span class="badge bg-primary mb-2">@post.Category</span>
                                <h5 class="card-title">
                                    <a asp-page="Details" asp-route-id="@post.Id" class="text-decoration-none text-dark">
                                        @post.Title
                                    </a>
                                </h5>
                                @if (!string.IsNullOrEmpty(post.Excerpt))
                                {
                                    <p class="card-text text-muted">@post.Excerpt</p>
                                }
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <small class="text-muted">
                                        <i class="fas fa-user"></i> @post.Author?.UserName<br/>
                                        <i class="fas fa-calendar"></i> @post.PublishedDate.ToString("MMM dd, yyyy")
                                    </small>
                                    <small class="text-muted">
                                        <i class="fas fa-eye"></i> @post.ViewCount views
                                    </small>
                                </div>
                                @if (!string.IsNullOrEmpty(post.Tags))
                                {
                                    <div class="mt-2">
                                        @foreach (var tag in post.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <span class="badge bg-secondary me-1">@tag.Trim()</span>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="card-footer bg-white">
                                <a asp-page="Details" asp-route-id="@post.Id" class="btn btn-sm btn-outline-primary">
                                    Read More <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
}
