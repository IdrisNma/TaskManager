@page
@model TaskManager.Pages.Blog.DeleteModel
@{
    ViewData["Title"] = "Delete Blog Post";
}

<div class="row">
    <div class="col-md-8 offset-md-2">
        <h1 class="mb-4 text-danger">Delete Blog Post</h1>

        @if (Model.BlogPost == null)
        {
            <div class="alert alert-danger">
                <h4>Post not found</h4>
                <p>The blog post you are trying to delete does not exist.</p>
                <a asp-page="Index" class="btn btn-primary">Back to Blog</a>
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>Warning:</strong> Are you sure you want to delete this post? This action cannot be undone.
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Title</dt>
                        <dd class="col-sm-9">@Model.BlogPost.Title</dd>

                        <dt class="col-sm-3">Category</dt>
                        <dd class="col-sm-9">
                            <span class="badge bg-primary">@Model.BlogPost.Category</span>
                        </dd>

                        @if (!string.IsNullOrEmpty(Model.BlogPost.Excerpt))
                        {
                            <dt class="col-sm-3">Excerpt</dt>
                            <dd class="col-sm-9">@Model.BlogPost.Excerpt</dd>
                        }

                        <dt class="col-sm-3">Author</dt>
                        <dd class="col-sm-9">@Model.BlogPost.Author?.UserName</dd>

                        <dt class="col-sm-3">Published Date</dt>
                        <dd class="col-sm-9">@Model.BlogPost.PublishedDate.ToString("MMMM dd, yyyy")</dd>

                        @if (Model.BlogPost.LastModifiedDate != null)
                        {
                            <dt class="col-sm-3">Last Modified</dt>
                            <dd class="col-sm-9">@Model.BlogPost.LastModifiedDate.Value.ToString("MMMM dd, yyyy")</dd>
                        }

                        <dt class="col-sm-3">Views</dt>
                        <dd class="col-sm-9">@Model.BlogPost.ViewCount</dd>

                        @if (!string.IsNullOrEmpty(Model.BlogPost.Tags))
                        {
                            <dt class="col-sm-3">Tags</dt>
                            <dd class="col-sm-9">
                                @foreach (var tag in Model.BlogPost.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="badge bg-secondary me-1">@tag.Trim()</span>
                                }
                            </dd>
                        }
                    </dl>

                    <form method="post">
                        <input type="hidden" asp-for="BlogPost.Id" />
                        
                        <hr class="my-4" />
                        
                        <div class="d-flex justify-content-between">
                            <a asp-page="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash"></i> Delete Post
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
}
